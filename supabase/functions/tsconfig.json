{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["deno.window", "deno.ns"],
    "types": ["https://deno.land/x/deno@v1.44.0/types.d.ts"],
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "module": "esnext",
    "moduleResolution": "bundler"
  },
  "include": ["**/*.ts"]
}
