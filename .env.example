# ── Propiedades environment variables ────────────────────────────────────────
# Copy to `.env.local` for local dev:  cp .env.example .env.local
#
# For deployment: add these to your Vercel project (Settings → Environment
# Variables). Supabase provisioning docs are in README.md.

# ── Supabase (required for all data pages) ───────────────────────────────────
# Project URL + publishable anon key from Supabase dashboard → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Site URL (required for tenant resolution + password-reset redirect) ──────
# Production URL (tenant apex). Used as the base for the password reset
# redirect and for multi-tenant subdomain resolution.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase service role (optional — currently unused) ──────────────────────
# Only required by server-side privileged operations (requireEnv("server")).
# Keep this secret; never expose it to the client.
# SUPABASE_SERVICE_ROLE_KEY=

# ── AI features (optional — DeepSeek primary, kie.ai fallback) ────────────────
# Description generation & property scoring degrade gracefully when unset.
# DeepSeek is used when DEEPSEEK_API_KEY is set; otherwise kie.ai (Gemini
# 2.5 Flash/Pro) is used when KIEAI_API_KEY is set.
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# KIEAI_API_KEY=
# KIEAI_MODEL=gemini-2.5-flash
# Free Gemini embeddings for semantic search (text-embedding-004, 768-dim
# pgvector, requires the 019 migration). Get a free key at
# https://aistudio.google.com/apikey. Unset = search falls back to keyword
# (ilike) matching. OpenAI is no longer used for embeddings.
# GEMINI_API_KEY=

# ── Universal importer (optional) ─────────────────────────────────────────────
# Server-side Google Maps key used for geocoding. Falls back to
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY when unset.
# GOOGLE_MAPS_SERVER_KEY=
# Public Google Maps key for client-side maps (geocoding, Places, Directions).
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional Map ID (Google Cloud Console → Maps → Map Management → Create Map ID).
# Enables AdvancedMarkerElement / gmp-advanced-marker. Without it the app
# falls back to the legacy marker API.
# NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
# Optional Jina AI Reader API key (https://r.jina.ai). Unset = anonymous tier.
# JINA_API_KEY=

# ── Flyer engagement alerts (optional) ────────────────────────────────────────
# Outgoing webhook URL for WhatsApp alert notifications when a prospect shows
# high engagement on a digital flyer. Unset = alerts are silently skipped.
# WHATSAPP_WEBHOOK_URL=

# ── WhatsApp Business Cloud API (inbound webhook + outbound replies) ──────────
# Inbound: Meta sends prospect messages to /api/whatsapp/webhook. The verify
# token is a secret string YOU choose; you enter the same value in the Meta
# App Dashboard when configuring the webhook callback URL.
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-secret-verify-token
# Outbound replies (auto-reply to booking intents) need these two from the
# Meta App Dashboard (WhatsApp → API Setup):
#   PHONE_NUMBER_ID  → shown in API Setup after connecting your phone number.
#   ACCESS_TOKEN     → use a PERMANENT system-user token (Business Settings →
#                      System users → Generate token) with permissions
#                      business_management, whatsapp_business_messaging,
#                      whatsapp_business_management. The temporary token from
#                      Quickstart expires and is only for testing.
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# APP_SECRET (from Meta App Dashboard → App settings → Basic) is used to verify
# the X-Hub-Signature-256 header on inbound webhook posts. If unset, the webhook
# skips signature verification (not recommended for production).
# WHATSAPP_APP_SECRET=
# Phone number in international format (e.g. 5215512345678) shown on the
# "Continuar en WhatsApp" button in the chat widget. Unset = button hidden.
# The NEXT_PUBLIC_ variant is what client components inline; if only
# WHATSAPP_BUSINESS_PHONE_NUMBER is set (server-only), the chat button stays
# hidden but the WhatsApp bot still works.
# NEXT_PUBLIC_WHATSAPP_BUSINESS_PHONE_NUMBER=
# WHATSAPP_BUSINESS_PHONE_NUMBER=
# Enable the WhatsApp chat bot (webhook answers property searches with the same
# engine as the site chatbot). "true" = enabled. Defaults to off.
# WHATSAPP_CHAT_ENABLED=false


